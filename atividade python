def maior(lista):
    m = lista[0]
    for item in lista:
        if item > m: m = item
    return m

def menor(lista):
    m = lista[0]
    for item in lista:
        if item < m: m = item
    return m

def soma(lista):
    s = 0
    for item in lista: s += item
    return s

def media(lista):
    return soma(lista) / len(lista)

