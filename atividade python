def analisar_texto():
    frase = input("Digite uma frase: ")
    
    total_caracteres = len(frase)
    espacos = 0
    vogais = 0
    consoantes = 0
    vogais_ref = "aeiouAEIOUáéíóúÁÉÍÓÚãõÃÕâêôÂÊÔ"

    for char in frase:
        if char == " ":
            espacos += 1
        elif char in vogais_ref:
            vogais += 1
        elif char.isalpha():
            consoantes += 1

    frase_invertida = ""
    for i in range(len(frase) - 1, -1, -1):
        frase_invertida += frase[i]

    print("\n--- Resultados ---")
    print("Quantidade de caracteres:", total_caracteres)
    print("Quantidade de espaços:", espacos)
    print("Quantidade de vogais:", vogais)
    print("Quantidade de consoantes:", consoantes)
    print("Frase invertida:", frase_invertida)

analisar_texto()

