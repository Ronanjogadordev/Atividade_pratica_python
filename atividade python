def sistema_votacao():
    votos = [0, 0, 0, 0, 0] # [Cand1, Cand2, Cand3, Branco, Nulo]
    
    while True:
        print("\n1. Candidato 1 | 2. Candidato 2 | 3. Candidato 3 | 4. Branco | 5. Nulo | 0. Encerrar")
        voto = int(input("Digite seu voto: "))
        if voto == 0:
            break
        elif 1 <= voto <= 5:
            votos[voto - 1] += 1
        else:
            print("Opção inválida!")

    total = sum(votos)
    if total == 0:
        print("Nenhum voto registrado.")
        return

    print("\n--- Resultado da Eleição ---")
    print(f"Total de votos: {total}")
    for i in range(3):
        pct = (votos[i] / total) * 100
        print(f"Candidato {i+1}: {votos[i]} votos ({pct:.1f}%)")
    
    print(f"Brancos: {votos[3]} ({(votos[3]/total)*100:.1f}%)")
    print(f"Nulos: {votos[4]} ({(votos[4]/total)*100:.1f}%)")

    # Determinar vencedor
    maior_votos = votos[0]
    vencedor = "Candidato 1"
    if votos[1] > maior_votos:
        maior_votos = votos[1]
        vencedor = "Candidato 2"
    if votos[2] > maior_votos:
        maior_votos = votos[2]
        vencedor = "Candidato 3"

    print(f"Vencedor: {vencedor}")

sistema_votacao()

def calcular_m(n1, n2):
    return (n1 + n2) / 2

def sistema_academico():
    nomes = []
    notas1 = []
    notas2 = []
    medias = []
    situacoes = []
    opcao = 0

    while opcao != 7:
        print("\n--- SISTEMA ACADÊMICO ---")
        print("1. Cadastrar aluno\n2. Lançar notas\n3. Calcular média\n4. Mostrar boletim")
        print("5. Mostrar aprovados\n6. Mostrar reprovados\n7. Encerrar")
        opcao = int(input("Opção: "))

        if opcao == 1:
            nomes.append(input("Nome do aluno: "))
            notas1.append(0.0)
            notas2.append(0.0)
            medias.append(0.0)
            situacoes.append("Pendente")
        elif opcao == 2:
            nome = input("Nome do aluno para lançar notas: ")
            if nome in nomes:
                idx = nomes.index(nome)
                notas1[idx] = float(input("Nota 1: "))
                notas2[idx] = float(input("Nota 2: "))
            else: print("Aluno não encontrado.")
        elif opcao == 3:
            for i in range(len(nomes)):
                medias[i] = calcular_m(notas1[i], notas2[i])
                situacoes[i] = "Aprovado" if medias[i] >= 7.0 else "Reprovado"
            print("Médias calculadas com sucesso.")
        elif opcao == 4:
            for i in range(len(nomes)):
                print(f"{nomes[i]} | N1: {notas1[i]} | N2: {notas2[i]} | Média: {medias[i]:.1f} | Situação: {situacoes[i]}")
        elif opcao == 5:
            print("--- Aprovados ---")
            for i in range(len(nomes)):
                if situacoes[i] == "Aprovado": print(f"- {nomes[i]}")
        elif opcao == 6:
            print("--- Reprovados ---")
            for i in range(len(nomes)):
                if situacoes[i] == "Reprovado": print(f"- {nomes[i]}")

sistema_academico()

def estoque():
    nomes = []
    quantidades = []
    precos = []
    opcao = 0

    while opcao != 8:
        print("\n--- GERENCIAMENTO DE ESTOQUE ---")
        print("1. Cadastrar produto\n2. Listar produtos\n3. Atualizar quantidade")
        print("4. Buscar produto\n5. Remover produto\n6. Mostrar produto mais caro")
        print("7. Mostrar valor total do estoque\n8. Encerrar")
        opcao = int(input("Escolha uma opção: "))

        if opcao == 1:
            nomes.append(input("Nome do produto: "))
            quantidades.append(int(input("Quantidade: ")))
            precos.append(float(input("Preço unitário: R$ ")))
        elif opcao == 2:
            for i in range(len(nomes)):
                print(f"{nomes[i]} - Qtd: {quantidades[i]} - Preço: R$ {precos[i]:.2f}")
        elif opcao == 3:
            nome = input("Produto a atualizar: ")
            if nome in nomes:
                idx = nomes.index(nome)
                quantidades[idx] = int(input("Nova quantidade: "))
            else: print("Produto não encontrado.")
        elif opcao == 4:
            nome = input("Buscar produto: ")
            if nome in nomes:
                idx = nomes.index(nome)
                print(f"Achado: {nomes[idx]} | Qtd: {quantidades[idx]} | Preço: R$ {precos[idx]:.2f}")
            else: print("Produto não encontrado.")
        elif opcao == 5:
            nome = input("Produto a remover: ")
            if nome in nomes:
                idx = nomes.index(nome)
                nomes.pop(idx)
                quantidades.pop(idx)
                precos.pop(idx)
                print("Removido com sucesso.")
            else: print("Produto não encontrado.")
        elif opcao == 6:
            if precos:
                idx_caro = 0
                for i in range(len(precos)):
                    if precos[i] > precos[idx_caro]: idx_caro = i
                print(f"Mais caro: {nomes[idx_caro]} (R$ {precos[idx_caro]:.2f})")
            else: print("Estoque vazio.")
        elif opcao == 7:
            total = 0
            for i in range(len(nomes)):
                total += quantidades[i] * precos[i]
            print(f"Valor total em estoque: R$ {total:.2f}")

estoque()
