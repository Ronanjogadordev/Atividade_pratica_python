def analisar_numeros():
    numeros = []
    for i in range(15):
        num = int(input(f"Digite o {i+1}º número inteiro: "))
        numeros.append(num)

    soma = 0
    maior = numeros[0]
    menor = numeros[0]
    pares = 0
    impares = 0

    for num in numeros:
        soma += num
        if num > maior:
            maior = num
        if num < menor:
            menor = num
        if num % 2 == 0:
            pares += 1
        else:
            impares += 1

    media = soma / len(numeros)

    print("\n--- Resultados ---")
    print("Lista completa:", numeros)
    print("Soma dos elementos:", soma)
    print("Média:", media)
    print("Maior valor:", maior)
    print("Menor valor:", menor)
    print("Quantidade de pares:", pares)
    print("Quantidade de ímpares:", impares)



def filtrar_unicos():
