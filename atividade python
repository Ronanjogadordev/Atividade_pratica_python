def cadastrar_produtos():
    nomes = []
    precos = []

    for i in range(8):
        nome = input(f"Nome do produto {i+1}: ")
        preco = float(input(f"Preço do produto {i+1}: R$ "))
        nomes.append(nome)
        precos.append(preco)

    soma = 0
    idx_caro = 0
    idx_barato = 0

    for i in range(len(precos)):
        soma += precos[i]
        if precos[i] > precos[idx_caro]:
            idx_caro = i
        if precos[i] < precos[idx_barato]:
            idx_barato = i

    media = soma / len(precos)
    acima_da_media = 0

    for preco in precos:
        if preco > media:
            acima_da_media += 1

    print("\n--- Análise de Produtos ---")
    print(f"Produto mais caro: {nomes[idx_caro]} (R$ {precos[idx_caro]:.2f})")
    print(f"Produto mais barato: {nomes[idx_barato]} (R$ {precos[idx_barato]:.2f})")
    print(f"Média dos preços: R$ {media:.2f}")
    print(f"Produtos acima da média: {acima_da_media}")

cadastrar_produtos()

