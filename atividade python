def calcular_media_aluno(n1, n2):
    return (n1 + n2) / 2

def sistema_notas():
    nomes = []
    medias = []

    for i in range(6):
        nome = input(f"Nome do aluno {i+1}: ")
        n1 = float(input(f"Nota 1 de {nome}: "))
        n2 = float(input(f"Nota 2 de {nome}: "))
        media = calcular_media_aluno(n1, n2)
        
        nomes.append(nome)
        medias.append(media)

    maior_m = medias[0]
    menor_m = medias[0]
    soma_m = 0
    aprovados = 0
    reprovados = 0

    for m in medias:
        soma_m += m
        if m > maior_m:
            maior_m = m
        if m < menor_m:
            menor_m = m
        if m >= 7.0:
            aprovados += 1
        else:
            reprovados += 1

    media_geral = soma_m / len(medias)

    print("\n--- Resumo da Turma ---")
    print(f"Maior média: {maior_m:.2f}")
    print(f"Menor média: {menor_m:.2f}")
    print(f"Aprovados: {aprovados}")
    print(f"Reprovados: {reprovados}")
    print(f"Média geral da turma: {media_geral:.2f}")

sistema_notas()

def ordenacao_manual():
    numeros = []
    for i in range(10):
        numeros.append(int(input(f"Digite o {i+1}º número: ")))

    original = list(numeros)

    # Bubble Sort manual
    n = len(numeros)
    for i in range(n):
        for j in range(0, n - i - 1):
            if numeros[j] > numeros[j + 1]:
                numeros[j], numeros[j + 1] = numeros[j + 1], numeros[j]

    print("\nLista original:", original)
    print("Lista ordenada:", numeros)

ordenacao_manual()

